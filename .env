# DATABASE_URL=postgresql://postgres:admin@localhost:5432/ecoprint

# FastAPI runtime DB
FASTAPI_DATABASE_URL=postgresql+psycopg2://<postgres_user>:<postgres_pass>@localhost:<postgres_port>/<postgres_db>

# Alembic migrations DB
ALEMBIC_DATABASE_URL=postgresql+psycopg2://<alembic_user>:<alembic_pass>@localhost:<postgres_port>/<postgres_db>
